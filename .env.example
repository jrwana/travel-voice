# Live AI is the primary demo path. Without a key, its CTA stays disabled and the verified replay suite remains available.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
# Narration defaults to OPENAI_API_KEY / OPENAI_AGENT_MODEL when these are empty.
NARRATOR_API_KEY=
NARRATOR_BASE_URL=
NARRATOR_MODEL=gpt-5.4-mini
NARRATOR_MAX_OUTPUT_TOKENS=1600
PORT=3001
SESSION_TTL_MINUTES=60
MAX_CALL_SECONDS=300
MAX_CONCURRENT_CALLS=3
MAX_DAILY_CALLS=50
MAX_SESSION_CALLS_PER_HOUR=5
MAX_IP_CALLS_PER_DAY=10
